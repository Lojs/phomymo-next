# Copy this file to .env and adjust as needed. Docker Compose reads .env
# automatically from the project directory.

# The hostname or IP address you'll open this app at. Used as the CN on the
# self-signed HTTPS certificate that's generated on first start.
#   - Accessing only from this machine:              localhost
#   - Accessing from other devices on your network:   your LAN IP or hostname,
#                                                       e.g. 192.168.1.50 or phomymo.lan
PHOMYMO_DOMAIN=localhost
